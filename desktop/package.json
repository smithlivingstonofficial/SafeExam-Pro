{
  "name": "safeexam-pro-desktop",
  "version": "1.0.0",
  "description": "SafeExam Pro — Secure Lockdown Desktop Examination Client",
  "main": "dist/main/index.js",
  "scripts": {
    "compile-hook": "node scripts/compile-hook.js",
    "build": "npm run compile-hook && tsc && node -e \"const fs=require('fs'); fs.cpSync('src/renderer', 'dist/renderer', {recursive: true});\"",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:nsis": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:mac:dmg": "npm run build && electron-builder --mac dmg",
    "dist:mac:zip": "npm run build && electron-builder --mac zip",
    "dist:all": "npm run build && electron-builder -mw"
  },
  "build": {
    "appId": "com.safeexam.lockdown",
    "productName": "SafeExam Pro",
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/safeexam-hook.exe",
        "to": "bin/safeexam-hook.exe"
      }
    ],
    "protocols": [
      {
        "name": "SafeExam Pro Protocol",
        "schemes": [
          "safeexam"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SafeExam Pro",
      "uninstallDisplayName": "SafeExam Pro Lockdown Client",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.ico",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": false
    },
    "dmg": {
      "title": "SafeExam Pro Installer",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "keywords": [
    "safeexam",
    "lockdown-browser",
    "proctoring",
    "secure-exam"
  ],
  "author": "SafeExam Pro Security Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3"
  }
}
